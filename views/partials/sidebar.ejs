<div class="w-64 h-screen fixed left-0 top-0 glass border-r border-white/5 p-8 flex flex-col z-50">
  <div class="flex items-center gap-3 mb-12">
    <div
      class="w-8 h-8 bg-gradient-to-br from-accent to-accent-light rounded-lg flex items-center justify-center font-bold text-lg">
      N</div>
    <h1 class="text-2xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-white/70">
      NEXUS</h1>
  </div>

  <nav class="flex flex-col gap-2 flex-1">
    <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-2 ml-1">Main Menu</p>

    <a href="/dashboard"
      class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group hover:bg-white/5 <%= (locals.title === 'Dashboard') ? 'bg-accent/10 text-accent' : 'text-gray-400 hover:text-white' %>">
      <span
        class="<%= (locals.title === 'Dashboard') ? 'text-accent' : 'text-gray-500 group-hover:text-white' %> transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="9" x="3" y="3" rx="1" />
          <rect width="7" height="5" x="14" y="3" rx="1" />
          <rect width="7" height="9" x="14" y="12" rx="1" />
          <rect width="7" height="5" x="3" y="16" rx="1" />
        </svg>
      </span>
      <span class="font-medium text-sm">Dashboard</span>
    </a>

    <a href="/form"
      class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group hover:bg-white/5 <%= (locals.title === 'New Submission') ? 'bg-accent/10 text-accent' : 'text-gray-400 hover:text-white' %>">
      <span
        class="<%= (locals.title === 'New Submission') ? 'text-accent' : 'text-gray-500 group-hover:text-white' %> transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="M12 5v14" />
        </svg>
      </span>
      <span class="font-medium text-sm">New Submission</span>
    </a>

    <a href="/submissions"
      class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group hover:bg-white/5 <%= (locals.title === 'Submissions') ? 'bg-accent/10 text-accent' : 'text-gray-400 hover:text-white' %>">
      <span
        class="<%= (locals.title === 'Submissions') ? 'text-accent' : 'text-gray-500 group-hover:text-white' %> transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
          <polyline points="14 2 14 8 20 8" />
        </svg>
      </span>
      <span class="font-medium text-sm">Submissions</span>
    </a>

    <a href="/profile"
      class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group hover:bg-white/5 <%= (locals.title === 'Profile') ? 'bg-accent/10 text-accent' : 'text-gray-400 hover:text-white' %>">
      <span
        class="<%= (locals.title === 'Profile') ? 'text-accent' : 'text-gray-500 group-hover:text-white' %> transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </span>
      <span class="font-medium text-sm">Profile</span>
    </a>
  </nav>

  <div class="mt-auto">
    <a href="/login"
      class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group hover:bg-red-500/10 text-gray-500 hover:text-red-400">
      <span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" x2="9" y1="12" y2="12" />
        </svg>
      </span>
      <span class="font-medium text-sm">Logout</span>
    </a>
  </div>
</div>