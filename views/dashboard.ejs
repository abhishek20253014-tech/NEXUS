<%- include('partials/head', { title: 'Dashboard' }) %>
  <%- include('partials/sidebar', { title: 'Dashboard' }) %>
    <%- include('partials/topbar', { title: 'Dashboard' }) %>

      <div class="ml-64 p-10 min-h-[calc(100vh-80px)]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <div class="glass-card p-6 rounded-2xl relative overflow-hidden group cursor-pointer">
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-accent/10 rounded-full -mr-16 -mt-16 blur-3xl group-hover:bg-accent/20 transition-all">
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-accent/10 rounded-xl text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m16 6 4 14H4L8 6" />
                  <path d="M12 2v4" />
                  <path d="m8 2 1 2" />
                  <path d="m16 2-1 2" />
                  <circle cx="12" cy="13" r="5" />
                  <path d="M12 18v2" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-400">Total Submissions</p>
                <p class="text-3xl font-bold mt-1">24</p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-secondary font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                <polyline points="16 7 22 7 22 13" />
              </svg>
              <span>+12% from last month</span>
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl relative overflow-hidden group cursor-pointer">
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-orange-500/10 rounded-full -mr-16 -mt-16 blur-3xl group-hover:bg-orange-500/20 transition-all">
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-orange-500/10 rounded-xl text-orange-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-400">Pending Review</p>
                <p class="text-3xl font-bold mt-1">8</p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-orange-500 font-medium">
              <span>Awaiting action</span>
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl relative overflow-hidden group cursor-pointer">
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-secondary/10 rounded-full -mr-16 -mt-16 blur-3xl group-hover:bg-secondary/20 transition-all">
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-secondary/10 rounded-xl text-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-400">Approved Items</p>
                <p class="text-3xl font-bold mt-1">16</p>
              </div>
            </div>
            <div class="mt-4 flex items-center text-xs text-secondary font-medium">
              <span>Increased output</span>
            </div>
          </div>
        </div>

        <div class="glass-card rounded-2xl overflow-hidden">
          <div class="p-6 border-b border-white/5 flex items-center justify-between">
            <h3 class="font-bold">Recent Submissions</h3>
            <button class="text-xs text-accent hover:underline font-medium">View all</button>
          </div>
          <div class="p-12 text-center">
            <div
              class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 border border-white/10 text-gray-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                <polyline points="14 2 14 8 20 8" />
              </svg>
            </div>
            <p class="text-gray-400 font-medium">No recent activity</p>
            <p class="text-sm text-gray-500 mt-1">When you submit new forms, they'll appear here.</p>
            <a href="/form"
              class="inline-block mt-6 px-6 py-2.5 bg-accent hover:bg-accent-hover text-white rounded-xl text-sm font-semibold transition-all">Create
              First Submission</a>
          </div>
        </div>
      </div>

      <%- include('partials/footer') %>