            </span>
          </td>
          <td>Jan 28</td>
          <td>
            <a href="#" class="text-accent hover:underline">View</a>
          </td>
        </tr>

        <tr class="hover:bg-white/5 transition">
          <td class="p-4">AI Bot</td>
          <td>
            <span class="px-3 py-1 rounded-full text-xs bg-green-400/10 text-green-400">
              Approved
            </span>
          </td>
          <td>Jan 25</td>
          <td>
            <a href="#" class="text-accent hover:underline">View</a>
          </td>
        </tr>

      </tbody>
    </table>

  </div>

</div>

<%- include('partials/footer') %>
