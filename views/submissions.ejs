<%- include('partials/head', { title: 'Submissions' }) %>
<%- include('partials/sidebar') %>
<%- include('partials/topbar', { title: 'Submissions' }) %>

<div class="ml-64 mt-16 p-10 space-y-8">

  <!-- Header -->
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-semibold">Submissions</h1>
    <a href="/form" class="bg-accent glow px-6 py-3 rounded-lg transition hover:scale-105">
      + New
    </a>
  </div>

  <!-- Table -->
  <div class="glass rounded-xl overflow-hidden" data-aos="fade-up">

    <table class="w-full text-left">
      <thead class="bg-white/5 text-gray-400 text-sm">
        <tr>
          <th class="p-4">Project</th>
          <th>Status</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>

      <tbody class="text-gray-300 divide-y divide-white/10">

        <tr class="hover:bg-white/5 transition">
          <td class="p-4">Fitness App</td>
          <td>
            <span class="px-3 py-1 rounded-full text-xs bg-yellow-400/10 text-yellow-400">
