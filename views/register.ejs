<%- include('partials/head', { title: 'Register' }) %>

<div class="min-h-screen flex items-center justify-center">
  <div class="bg-card p-8 rounded-xl w-96 shadow-xl">
    <h1 class="text-2xl mb-6 text-accent">Create Account</h1>

    <form method="POST" action="/register">

      <input
        name="email"
        type="email"
        class="w-full p-3 mb-4 bg-bg border border-white/10 rounded"
        placeholder="Email"
        required
      />

      <input
        name="password"
        type="password"
        class="w-full p-3 mb-4 bg-bg border border-white/10 rounded"
        placeholder="Password"
        required
      />

      <button class="w-full bg-accent p-3 rounded">
        Register
      </button>

    </form>

    <p class="mt-4 text-sm text-gray-400">
      Already have an account?
      <a href="/login" class="text-accent">Login</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
