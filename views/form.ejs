<%- include('partials/head', { title: 'New Submission' }) %>
<%- include('partials/sidebar') %>
<%- include('partials/topbar', { title: 'New Submission' }) %>

<div class="ml-64 mt-16 p-10 max-w-3xl space-y-8">

  <div class="glass p-8 rounded-xl glow" data-aos="fade-up">
    <h1 class="text-2xl font-semibold mb-6">Create New Submission</h1>

    <form method="POST" action="/submit" class="space-y-6">

      <!-- Title -->
      <div>
        <label class="text-sm text-gray-400">Title</label>
        <input
          name="title"
          class="w-full mt-2 p-4 bg-bg border border-white/10 rounded-lg focus:outline-none focus:border-accent"
          placeholder="Project name"
        />
      </div>

      <!-- Description -->
      <div>
        <label class="text-sm text-gray-400">Description</label>
        <textarea
          name="description"
          class="w-full mt-2 p-4 bg-bg border border-white/10 rounded-lg h-32 focus:outline-none focus:border-accent"
          placeholder="Describe your project..."
        ></textarea>
      </div>

      <!-- Action -->
      <div class="flex justify-end">
        <button class="bg-accent glow px-8 py-3 rounded-lg transition hover:scale-105">
          Submit
        </button>
      </div>

    </form>

  </div>

</div>

<%- include('partials/footer') %>
