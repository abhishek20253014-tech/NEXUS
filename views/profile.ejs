<%- include('partials/head', { title: 'Profile' }) %>
  <%- include('partials/sidebar', { title: 'Profile' }) %>
    <%- include('partials/topbar', { title: 'Profile' }) %>

      <div class="ml-64 p-10 min-h-[calc(100vh-80px)]">
        <div class="max-w-2xl">
          <div class="glass-card p-10 rounded-2xl">
            <div class="flex items-center gap-6 mb-10 pb-10 border-b border-white/5">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-accent to-accent-light p-1">
                <div
                  class="w-full h-full rounded-2xl bg-card flex items-center justify-center text-3xl font-bold text-accent">
                  AU</div>
              </div>
              <div>
                <h2 class="text-2xl font-bold">Admin User</h2>
                <p class="text-accent font-medium mt-1">Pro Account</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Username</label>
                <div class="p-4 bg-white/5 rounded-xl border border-white/10 font-mono text-accent">@<%= user.username
                    %>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Email
                  Address</label>
                <div class="p-4 bg-white/5 rounded-xl border border-white/10 font-medium">
                  <%= user.email %>
                </div>
              </div>
            </div>

            <div class="mt-12 flex items-center gap-4">
              <button
                class="px-8 py-3.5 bg-accent hover:bg-accent-hover text-white font-semibold rounded-xl active:scale-[0.98] transition-all">
                Update Profile
              </button>
              <a href="/login"
                class="px-8 py-3.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 font-semibold rounded-xl transition-all">
                Log Out
              </a>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/footer') %>