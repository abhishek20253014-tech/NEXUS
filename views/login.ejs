<%- include('partials/head', { title: 'Login' }) %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-bg via-black to-bg">

  <div class="glass glow p-10 rounded-2xl w-96" data-aos="zoom-in">

    <!-- Logo -->
    <div class="flex items-center gap-3 mb-8 justify-center">
      <div class="w-10 h-10 bg-accent glow rounded-xl"></div>
      <h1 class="text-2xl font-bold tracking-wide">NEXUS</h1>
    </div>

    <form method="POST" action="/login" class="space-y-6">

      <div>
        <label class="text-sm text-gray-400">Email</label>
        <input
          name="email"
          type="email"
          class="w-full mt-2 p-4 bg-bg border border-white/10 rounded-lg focus:outline-none focus:border-accent"
          placeholder="you@nexus.ai"
          required
        />
      </div>

      <div>
        <label class="text-sm text-gray-400">Password</label>
        <input
          name="password"
          type="password"
          class="w-full mt-2 p-4 bg-bg border border-white/10 rounded-lg focus:outline-none focus:border-accent"
          placeholder="••••••••"
          required
        />
      </div>

      <button class="w-full bg-accent glow py-3 rounded-lg transition hover:scale-105">
        Enter NEXUS
      </button>

    </form>

    <p class="mt-6 text-sm text-center text-gray-400">
      New here?
      <a href="/register" class="text-accent hover:underline">Create account</a>
    </p>

  </div>

</div>

<%- include('partials/footer') %>
